{
	"name": "@bame/storage-local",
	"version": "0.2.0",
	"description": "Local JSON file storage adapter and standalone Node.js HTTP server for Bame",
	"license": "MIT",
	"author": "Víctor Granados (https://github.com/vgharinero)",
	"repository": {
		"type": "git",
		"url": "https://github.com/vgharinero/bame.git",
		"directory": "packages/storage/local"
	},
	"homepage": "https://github.com/vgharinero/bame#readme",
	"keywords": [
		"bame",
		"storage",
		"local",
		"json",
		"server"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "pnpm clean && tsc",
		"typecheck": "tsc --noEmit",
		"dev": "tsc --watch",
		"clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
	},
	"dependencies": {
		"@bame/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.0.0"
	}
}
