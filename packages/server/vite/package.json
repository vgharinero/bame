{
	"name": "@bame/server-vite",
	"version": "0.2.0",
	"description": "Vite dev and preview middleware adapter for Bame Fetch handlers",
	"license": "MIT",
	"author": "Víctor Granados (https://github.com/vgharinero)",
	"repository": {
		"type": "git",
		"url": "https://github.com/vgharinero/bame.git",
		"directory": "packages/server/vite"
	},
	"homepage": "https://github.com/vgharinero/bame#readme",
	"keywords": [
		"bame",
		"vite",
		"plugin",
		"server",
		"turn-based"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "pnpm clean && tsc",
		"typecheck": "tsc --noEmit",
		"dev": "tsc --watch",
		"clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
	},
	"dependencies": {
		"@bame/server-node": "workspace:*"
	},
	"peerDependencies": {
		"vite": ">=5"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.0.0"
	}
}
