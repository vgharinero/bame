{
	"name": "@bame/server-node",
	"version": "0.2.0",
	"description": "Node.js HTTP/Connect bridge and standalone server adapter for Bame",
	"license": "MIT",
	"author": "Víctor Granados (https://github.com/vgharinero)",
	"repository": {
		"type": "git",
		"url": "https://github.com/vgharinero/bame.git",
		"directory": "packages/server/node"
	},
	"homepage": "https://github.com/vgharinero/bame#readme",
	"keywords": [
		"bame",
		"node",
		"http",
		"server",
		"sse",
		"turn-based"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "pnpm clean && tsc",
		"typecheck": "tsc --noEmit",
		"dev": "tsc --watch",
		"clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
	},
	"dependencies": {
		"@bame/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.0.0"
	}
}
