{
	"name": "@bame/core",
	"version": "0.2.0",
	"description": "Zero-dependency, type-safe turn-based game engine with lobbies, hidden state, seeded RNG, and authoritative server transport",
	"license": "MIT",
	"author": "Víctor Granados (https://github.com/vgharinero)",
	"repository": {
		"type": "git",
		"url": "https://github.com/vgharinero/bame.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/vgharinero/bame#readme",
	"keywords": [
		"bame",
		"game-engine",
		"turn-based",
		"multiplayer",
		"board-game",
		"typescript"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "pnpm clean && tsc",
		"typecheck": "tsc --noEmit",
		"dev": "tsc --watch",
		"clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
	}
}
